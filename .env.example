# ── model-bridge configuration ──────────────────────────────
# Copy this file to .env, or just run the app — any missing
# secret below is auto-generated into .env on first start.

# HTTP server
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL ──────────────────────────────────────────────
# Docker Compose reads PG_PASSWORD (and optionally PG_USER /
# PG_DATABASE) to provision the bundled postgres container, and
# the backend connects via DATABASE_URL.
#
# Local dev tip: run an SSH tunnel to the prod server first
#   ssh -L 5432:127.0.0.1:5432 you@server
# then point DATABASE_URL at localhost — same data as prod.
PG_USER=model_bridge
PG_PASSWORD=
PG_DATABASE=model_bridge
DATABASE_URL=

# AES-256 key for encrypting OAuth tokens at rest — 64 hex chars.
# Auto-generated if left blank. Generate manually: openssl rand -hex 32
ENCRYPTION_KEY=

# Secret for signing admin session JWTs.
# Auto-generated if left blank. Generate manually: openssl rand -hex 32
JWT_SECRET=

# Initial admin account, created on first run. Change the password!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Gemini CLI OAuth client credentials. Copy the values from the
# upstream Gemini CLI source (the public "installed app" client
# embedded in the CLI binary):
#   https://github.com/google-gemini/gemini-cli
#   packages/core/src/code_assist/oauth2.ts
# They are required to log in with a Google account.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
