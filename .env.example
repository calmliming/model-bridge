# ── model-bridge configuration ──────────────────────────────
# Copy this file to .env, or just run the app — any missing
# secret below is auto-generated into .env on first start.
#
# ── 本地 / 线上环境区分（重要）──────────────────────────────
# 本项目用两个独立的配置文件隔离本地开发与线上生产：
#
#   本地：.env.local     → 连本地 PostgreSQL 容器(5433)，端口 3003
#   线上：.env           → 连线上库，端口 3000（容器内）
#
# 判定规则见 src/config.ts：**只要仓库根目录存在 .env.local，且不在容器里**
# （NODE_ENV != production），就按本地模式加载 .env.local；否则读 .env。
# 注意判定看的是文件本身，不是环境变量——这样父进程/CI 继承来的
# APP_ENV、DATABASE_URL 都无法把本地进程悄悄拽到线上库。
#
# 本地首次启动：
#   cp .env.example .env.local   # 然后按下面注释改成本地库
#   # 确认 PORT=3003、DATABASE_URL 指向 127.0.0.1:5433
#   npm run dev:db               # 起本地 PostgreSQL 容器
#   npm run dev:all              # 起后端 + 前端
#
# 另有一道保险：本地模式下若 DATABASE_URL 指向非回环主机，
# src/db/index.ts 会直接拒绝启动，除非显式设置 ALLOW_REMOTE_DB=true。

# 可选说明性字段：只用于人工阅读和启动横幅，不参与模式判定。
# 本地建议写 local，线上写 production（留空也按线上处理）。
APP_ENV=production

# HTTP server
PORT=3000
HOST=0.0.0.0

# ── PostgreSQL ──────────────────────────────────────────────
# Docker Compose reads PG_PASSWORD (and optionally PG_USER /
# PG_DATABASE) to provision the bundled postgres container, and
# the backend connects via DATABASE_URL.
#
# 本地开发推荐用仓库自带的容器（npm run dev:db）：
#   DATABASE_URL=postgresql://model_bridge:devpassword@127.0.0.1:5433/model_bridge
#
# 如果确实想让本地进程连线上库调试，请显式打开闸门并自担风险：
#   ALLOW_REMOTE_DB=true
# 该模式下本地所有写操作都会真实作用在线上数据上。
PG_USER=model_bridge
PG_PASSWORD=
PG_DATABASE=model_bridge
DATABASE_URL=

# 本地误连远端库的显式闸门，仅本地模式生效。默认 false（拒绝启动）。
ALLOW_REMOTE_DB=

# AES-256 key for encrypting OAuth tokens at rest — 64 hex chars.
# Auto-generated if left blank. Generate manually: openssl rand -hex 32
# 本地与线上必须各用一套独立密钥，不要复制粘贴。
ENCRYPTION_KEY=

# Secret for signing admin session JWTs.
# Auto-generated if left blank. Generate manually: openssl rand -hex 32
JWT_SECRET=

# Initial admin account, created on first run. Change the password!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Internal system updater ─────────────────────────────────
# Docker Compose injects UPDATER_URL automatically. UPDATE_TOKEN
# is generated by install.sh and shared only between the app and
# model-bridge-updater.
UPDATER_URL=
UPDATE_TOKEN=

# ── Login security ─────────────────────────────────────────
# Optional Cloudflare Turnstile challenge for login/register.
# Both values must be set for enforcement.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google website sign-in (Web application OAuth client ID).
# Add your website origin to Google Cloud > Authorized JavaScript origins.
# Uses the Google popup + JavaScript callback; no client secret/redirect URI needed.
# Separate from GEMINI_OAUTH_CLIENT_ID and ANTIGRAVITY_OAUTH_CLIENT_ID.
GOOGLE_LOGIN_CLIENT_ID=

# Sends CSP, X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy.
SECURITY_HEADERS_ENABLED=true

# Dashboard/API abuse protection (requests per minute). Database settings with
# the same names can override these defaults at runtime.
PANEL_AUTHENTICATED_RATE_LIMIT=300
PANEL_PUBLIC_RATE_LIMIT=60
PANEL_WRITE_RATE_LIMIT=10

# IANA timezone for dashboard "today" stat boundaries (default Asia/Shanghai).
# Anchors daily figures to this zone regardless of the server's OS timezone.
# An unrecognized value falls back to UTC.
STATS_TIMEZONE=Asia/Shanghai

# ── Shared runtime state / sticky sessions ───────────────────
# Optional Redis backend for cross-instance rate limits, concurrency gates,
# and sticky session bindings. Leave blank for single-process in-memory state.
REDIS_URL=

# If a sticky session's bound upstream account is at its concurrency limit,
# wait this many milliseconds before falling back to another account.
# Set to 0 to disable sticky waiting.
STICKY_SESSION_WAIT_MS=15000

# Expose /v1/images/generations and /v1/images/edits through OpenAI OAuth
# accounts, and allow explicit image_generation tools on /v1/responses.
OPENAI_IMAGE_GENERATION_ENABLED=true

# Cool only an account's image capability after an explicit upstream
# image_generation-unavailable signal. Text requests remain available.
OPENAI_IMAGE_UNAVAILABLE_COOLDOWN_MINUTES=30

# ── Upstream URL / SSRF protection ─────────────────────────
# Enabled by default. Custom upstream URLs are limited to HTTP(S), public IPs,
# and standard ports. Add exact hosts (or *.example.com) for trusted intranet
# gateways; add any required non-standard ports separately.
UPSTREAM_URL_GUARD_ENABLED=true
UPSTREAM_HOST_ALLOWLIST=
UPSTREAM_PORT_ALLOWLIST=80,443

# Gemini CLI OAuth client credentials. Copy the values from the
# upstream Gemini CLI source (the public "installed app" client
# embedded in the CLI binary):
#   https://github.com/google-gemini/gemini-cli
#   packages/core/src/code_assist/oauth2.ts
# Both are required for Gemini upstream account authorization and must be
# passed into the app container. Website sign-in uses GOOGLE_LOGIN_CLIENT_ID
# instead; its Web client ID does not replace these Gemini CLI credentials.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Native Google Antigravity (separate from Gemini CLI and Sub2API).
# Set the installed-app OAuth client secret matching the Antigravity client ID.
# Protocol reference: Wei-Shaw/sub2api backend/internal/pkg/antigravity/oauth.go.
# These are client identifiers; never put a Google password here.
ANTIGRAVITY_OAUTH_CLIENT_ID=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=2.12.2
ANTIGRAVITY_API_HOST=daily-cloudcode-pa.googleapis.com
# Optional HTTP(S)/SOCKS5 egress proxy, shared by OAuth, refresh, quota and generation.
# Example in Docker: http://host.docker.internal:7890
ANTIGRAVITY_PROXY_URL=

# ── Payment Providers ───────────────────────────────────────
# 支付宝配置（可选）
# production 读取下列环境变量；sandbox 读取项目根受保护的 .alipay-sandbox.json。
ALIPAY_ENV=production
ALIPAY_APP_ID=
# Node.js 使用 PKCS#1 原始私钥字符串，不要添加 PEM 头尾。
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱联调时设为 https://openapi-sandbox.dl.alipaydev.com/gateway.do；
# 生产留空时使用 https://openapi.alipay.com/gateway.do。
ALIPAY_GATEWAY=
# 本地无公网 HTTPS 地址时可暂留空；生产上线前必须配置并完成通知联调。
ALIPAY_NOTIFY_URL=
# AI 网页应用收款必填，必须指向本站真实 GET 路由：
# https://你的域名/api/payment/return/alipay
ALIPAY_RETURN_URL=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
# 充值金额从 USD 换算为支付宝 CNY 订单金额时使用，最多 4 位小数。
ALIPAY_USD_CNY_RATE=7.20

# 微信支付配置（可选）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
