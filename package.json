{
  "name": "model-bridge",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Self-hosted AI API relay platform — Claude / OpenAI / Gemini subscriptions as standard APIs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/db-guard.mjs generate",
    "db:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "diagnose:sub2api": "tsx scripts/diagnose-sub2api.ts",
    "pay:smoke": "tsx scripts/alipay-sandbox-smoke.ts",
    "pay:check": "tsx scripts/alipay-production-check.ts",
    "fix:sub2api-cooldown": "tsx scripts/clear-sub2api-cooldown.ts",
    "fix:cooldown": "tsx scripts/clear-account-cooldown.ts",
    "dev:db": "node scripts/dev-db.mjs up",
    "dev:db:down": "node scripts/dev-db.mjs down",
    "dev:db:reset": "node scripts/dev-db.mjs reset"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/static": "^10.1.6",
    "alipay-sdk": "^4.14.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.11.0",
    "pg": "^8.13.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "fsevents": false
  }
}
