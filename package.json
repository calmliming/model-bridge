{
  "name": "model-bridge",
  "version": "0.1.157",
  "private": true,
  "type": "module",
  "description": "Self-hosted AI API relay platform — Claude / OpenAI / Gemini subscriptions as standard APIs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/db-guard.mjs generate",
    "db:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
